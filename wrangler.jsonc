{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-portifolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "www",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/*.*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
